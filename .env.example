# Copy to .env (or just export these variables in your shell)
# Use ONE of these (the assistant picks whichever is set; force with LLM_PROVIDER=gemini|anthropic)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-5-5
# The dataset ends on 31 Oct 2026. "Today" for relative words like yesterday/last week:
ASSISTANT_TODAY=2026-11-01
QUERY_TIMEOUT_SECONDS=10
# Cost logging uses list prices from assistant/pricing.py; override (USD per 1M tokens) if yours differ:
# LLM_PRICE_INPUT_PER_MTOK=0.30
# LLM_PRICE_OUTPUT_PER_MTOK=2.50
MAX_ROWS=500
# Only for the Telegram bot:
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to use the bot (empty = anyone: demo only)
TELEGRAM_ALLOWED_USER_IDS=
